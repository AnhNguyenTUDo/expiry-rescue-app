{
  "name": "web-ui",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "format:check": "prettier --check . & eslint .",
    "prepare": "husky"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.5.5",
    "@tailwindcss/vite": "^4.1.17",
    "axios": "^1.13.2",
    "dayjs": "^1.11.13",
    "flowbite": "^4.0.1",
    "nuxt": "^4.2.1",
    "pinia": "^2.2.6",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.1.17",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@prettier/plugin-xml": "^3.4.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "nuxt-svg-sprite-icon": "^2.0.5",
    "prettier": "^3.8.3",
    "shadcn-nuxt": "^2.3.3"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix --quiet",
      "prettier --write --ignore-unknown"
    ],
    "*.{css,json}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
